---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="ru">
  <title>АНО «ФАКТОРИАЛ» — События</title>
  <subtitle>Культурно-научные и образовательные проекты</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}/" rel="alternate" type="text/html" />
  <id>{{ site.url }}/</id>
  <updated>{% assign first_post = site.posts | first %}{% if first_post %}{{ first_post.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author>
    <name>АНО «ФАКТОРИАЛ»</name>
  </author>

  {% for post in site.posts %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html" />
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.excerpt | xml_escape }}</summary>
    <content type="html">{{ post.content | remove: site.excerpt_separator | xml_escape }}</content>
    {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {% endfor %}
  </entry>
  {% endfor %}
</feed>
